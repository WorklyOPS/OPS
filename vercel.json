
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/(config|controllers|middleware|services|views|sql)(/.*)?$",
      "status": 404
    },
    {
      "src": "^/\\.",
      "status": 404
    },
    {
      "src": "^/uploads/.*\\.(php[0-9]?|phtml|phar|pl|py|jsp|asp|sh|cgi)$",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/api/index.php"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
