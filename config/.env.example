# =======================================================================
# WORKLY PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION (PHP 8 + POSTGRESQL)
# Copy this file to /config/.env and set real production credentials.
# Never commit /config/.env to GitHub.
# =======================================================================

APP_ENV=production
APP_URL=https://your-domain.com

# PostgreSQL Database Connection (Hostinger PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=workly_prod
DB_USER=workly_pg_user
DB_PASS=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DB_SSLMODE=prefer

# Cryptographic Signing Keys (Generate unique 64-char hex strings)
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
CSRF_SALT=REPLACE_WITH_32_CHAR_RANDOM_HEX_SALT

# Optional Integrations (leave empty if unused)
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Upload Limits (Bytes)
UPLOAD_MAX_AVATAR_BYTES=5242880
UPLOAD_MAX_CONTRACT_BYTES=15728640
